{
  "$schema": "./node_modules/oxlint/configuration_schema.json",

  "ignorePatterns": ["dist/**", ".next/**", "node_modules/**"],

  "plugins": [
    "eslint",
    "unicorn",
    "typescript",
    "oxc",
    "jsdoc",
    "jsx-a11y",
    "nextjs",
    "promise",
    "react",
    "react-perf",
    "import"
  ],

  "rules": {
    "eslint/complexity": ["warn", { "max": 10 }]
  }
}
